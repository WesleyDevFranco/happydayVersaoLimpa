{$DOMAIN} {
	encode zstd gzip

	# Uploaded photos are content-addressed, so they can be cached hard.
	@media path /api/media/*
	header @media Cache-Control "public, max-age=31536000, immutable"

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		# Published sites are meant to be opened from a WhatsApp message,
		# so HSTS only after the domain is settled. Uncomment then:
		# Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}

	# The app rate-limits by IP, so the address it sees has to be the one
	# Caddy actually accepted the connection from. Setting (not appending)
	# these overwrites anything the client sent: without it, a spoofed
	# X-Forwarded-For would give every request a fresh allowance.
	reverse_proxy app:3000 {
		header_up X-Forwarded-For {remote_host}
		header_up X-Real-IP {remote_host}
	}

	log {
		output file /data/access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
